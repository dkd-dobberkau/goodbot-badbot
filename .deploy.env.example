# Copy to .deploy.env and fill in. .deploy.env is gitignored.
# Used by deploy.sh to deploy and by docker-compose.mittwald.yml at deploy time.

# Mittwald resource identifiers — not credentials, but kept out of the
# public repo as reconnaissance friction.
STACK_ID=
PROJECT_ID=

# Mittwald MySQL service — values are interpolated into
# docker-compose.mittwald.yml.
MYSQL_HOST=
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=

# Salt for the visitor-IP digest (app/main.py). Generate once with
#   openssl rand -hex 32
# and then KEEP IT STABLE: changing it starts a new pseudonym space, so
# COUNT(DISTINCT ip_hash) double-counts callers seen across the change.
IP_HASH_SALT=

# Days a visit row is kept before the retention sweep deletes it.
# The privacy notice states this number — change both together.
VISIT_RETENTION_DAYS=180
